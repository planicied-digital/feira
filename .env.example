POSTGRES_USER=feira
POSTGRES_PASSWORD=feira
POSTGRES_DB=feira

DATABASE_URL=postgresql://feira:feira@db:5432/feira?schema=public

BACKEND_PORT=3333

# Porta do gateway local (docker-compose.local-proxy.yml), que publica o app em
# http://localhost:8090/sistemas/feira
GATEWAY_PORT=8090

# Hosts extras liberados no dev server do Vite, separados por vírgula — necessário só quando um
# proxy reverso externo (ex.: domínio da VPS) repassa o Host original pro container do frontend
# em modo dev. localhost já é sempre permitido, não precisa listar aqui.
# VITE_ALLOWED_HOSTS=13.140.39.163.sslip.io
