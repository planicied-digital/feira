# Copie para .env.prod na VPS (dentro da pasta do projeto) e preencha com
# valores reais. Este arquivo (.example) é o único que vai pro git — o
# .env.prod de verdade fica só na VPS (está no .gitignore).
# scripts/migrar-vps-para-prod.sh cria o .env.prod com uma senha aleatória se ele não existir.

POSTGRES_USER=feira
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=feira

# Token exigido no POST /import (header Authorization: Bearer <token>). Se ficar vazio,
# scripts/deploy-vps.sh gera um aleatório no primeiro deploy.
IMPORT_TOKEN=

# Porta publicada em 127.0.0.1 na VPS pro container do frontend (que também
# repassa /sistemas/feira/api/ pro backend) — o nginx do host faz proxy_pass
# pra ela. Escolhida para não colidir com o agendaclinica (3000 e 8080) nem com
# o gateway da stack de dev (8090), que fica de pé até a virada.
FEIRA_PORT=8091
