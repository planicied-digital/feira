# Copie para .env.prod na VPS (dentro da pasta do projeto) e preencha com
# valores reais. Este arquivo (.example) é o único que vai pro git — o
# .env.prod de verdade fica só na VPS (está no .gitignore).

POSTGRES_USER=feira
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=feira

DATABASE_URL=postgresql://feira:troque-por-uma-senha-forte@db:5432/feira?schema=public

# Portas publicadas em 127.0.0.1 na VPS — o nginx do host é quem expõe
# publicamente em /sistemas/feira/. Escolhidas para não colidir com o
# agendaclinica (que usa 3000 e 8080).
FEIRA_BACKEND_PORT=3001
FEIRA_FRONTEND_PORT=8081
